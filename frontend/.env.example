# ==========================================================================
# فرانت‌اند سنا — نمونه فایل تنظیمات محیطی
# این فایل را به .env کپی کنید و مقادیر متناسب با محیط خود تغییر دهید.
# ==========================================================================

# API Base URL (برای تولید باید URL کامل API باشد)
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Environment
VITE_NODE_ENV=development

# Feature Flags
VITE_ENABLE_SWAGGER=false
VITE_ENABLE_MOCK_API=false

# PWA
VITE_PWA_ENABLED=true