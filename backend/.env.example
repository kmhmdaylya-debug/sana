# ==========================================================================
# سامانه مدیریت منابع انسانی «سنا» — نمونه فایل تنظیمات محیطی بک‌اند
# این فایل را به .env کپی کنید و مقادیر متناسب با محیط خود تغییر دهید.
# ==========================================================================

NODE_ENV=development
PORT=4114
APP_NAME=سامانه مدیریت منابع انسانی «سنا»
API_PREFIX=api
SWAGGER_ENABLED=true

# --- پایگاه داده (Docker Compose) ---
# برای اجرای بومی PostgreSQL مقدار زیر را استفاده کنید:
DATABASE_URL=postgresql://sana:CHANGE_ME_DB_PASSWORD@localhost:5433/sana_hrms?schema=public
PRISMA_LOG_QUERIES=false
# نشانی شنود سرور (در Docker مقدار 0.0.0.0)
HOST=127.0.0.1

# --- CORS ---
CORS_ORIGINS=http://localhost:5183,http://127.0.0.1:5183

# --- Trusted Proxies (برای X-Forwarded-For و X-Request-ID) ---
TRUSTED_PROXIES=127.0.0.1

# --- Timezone ---
TZ=Asia/Tehran

# --- کلیدهای JWT (حتماً تغییر دهید؛ حداقل ۳۲ کاراکتر) ---
# برای تولید کلید تصادفی در PowerShell:
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
JWT_ACCESS_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_TO_ANOTHER_LONG_RANDOM_SECRET_32_CHARS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7
JWT_REMEMBER_ME_EXPIRES_DAYS=30
JWT_ISSUER=sana-hrms
JWT_REFRESH_GRACE_SECONDS=5

# --- امنیت ---
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_LIMIT=300
AUTH_RATE_LIMIT_LIMIT=5
PASSWORD_MIN_LENGTH=10
# حد مجاز انحراف ساعت دستگاه حضور و غیاب (ثانیه)
DEVICE_CLOCK_SKEW_SECONDS=120
# منبع معتبر زمان: SERVER | DEVICE
ATTENDANCE_TIME_SOURCE=SERVER

# --- حقوق و دستمزد ---
PAYROLL_CURRENCY=IRR
PAYROLL_DISPLAY_UNIT=RIAL
WORKING_DAYS_PER_MONTH=30
DEFAULT_WORK_HOURS_PER_DAY=8

# --- پشتیبان‌گیری ---
BACKUP_DIR=./backups
BACKUP_MAX_FILES=10
PG_DUMP_PATH=pg_dump
PG_RESTORE_PATH=pg_restore
# Optional, empty dedicated database only; never the active application database.
BACKUP_RESTORE_DATABASE_URL=
# کلید رمزنگاری فایل‌های پشتیبان — حداقل ۳۲ نویسهٔ تصادفی (بدون مقدار پیش‌فرض)
BACKUP_ENCRYPTION_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS

# --- کاربر مدیر اولیه (برای اسکریپت seed) ---
# رمز عبور باید حداقل ۱۰ کاراکتر و ترکیبی از حرف بزرگ/کوچک/عدد/نماد باشد.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
ADMIN_FULLNAME=مدیر سیستم
ADMIN_EMAIL=admin@example.com
# ساخت داده‌های نمونه (توسعه) — در تولید ممنوع است
SEED_DEMO_DATA=false
# رمز کاربران نمونه (فقط وقتی SEED_DEMO_DATA=true)
DEMO_PASSWORD_ALI=CHANGE_ME_DEMO_PASSWORD_1
DEMO_PASSWORD_MARYAM=CHANGE_ME_DEMO_PASSWORD_2

# --- Audit ---
AUDIT_FAIL_OPEN=true
AUDIT_ALERT_ON_FAILURE=true

# --- Antivirus (اختیاری) ---
ANTIVIRUS_ENABLED=false
ANTIVIRUS_COMMAND=clamscan
ANTIVIRUS_TIMEOUT_MS=30000
